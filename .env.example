# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Without these the app still works, saving progress on this device only (no accounts).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "publishable" key (older projects call it the "anon" key; NEXT_PUBLIC_SUPABASE_ANON_KEY works too).
# Safe in the browser: row-level security restricts what it can read. Never use the secret/service_role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
